[Desktop Entry]
Type=Application
Version=1.1
Name=ddcui-rs
GenericName=Monitor Settings
Comment=Control external monitor brightness and other DDC/CI settings
Keywords=ddcutil;DDC/CI;MCCS;monitor;brightness;contrast;
Exec=ddcui-rs
TryExec=ddcui-rs
Icon=io.github.jerinshop7_maker.DdcuiRs
Terminal=false
Categories=Settings;HardwareSettings;
Actions=SetBrightness25;SetBrightness50;SetBrightness75;SetBrightness100;

[Desktop Action SetBrightness25]
Name=Set Brightness to 25%
Exec=ddcui-rs --set-brightness 25

[Desktop Action SetBrightness50]
Name=Set Brightness to 50%
Exec=ddcui-rs --set-brightness 50

[Desktop Action SetBrightness75]
Name=Set Brightness to 75%
Exec=ddcui-rs --set-brightness 75

[Desktop Action SetBrightness100]
Name=Set Brightness to 100%
Exec=ddcui-rs --set-brightness 100
